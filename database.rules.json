{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('role').val() === 'merchant' : newData.child('role').val() === data.child('role').val())"
      }
    },
    "tickets": {
      ".read": "auth != null",
      "$ticketId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['title', 'description', 'status', 'owner_uid'])"
      }
    },
    "knowledge_base": {
      ".read": "auth != null",
      "$kbId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'cs')",
        ".validate": "newData.hasChildren(['title', 'content'])"
      }
    }
  }
}
